# Optional OpenAI API key (the default AI path is your own subscription via `iscale helper`)
OPENAI_API_KEY=
ISCALE_LISTINGS_ALLOW_SERVER_AI_KEYS=false

# Trademark check (calls iscale-listings API)
# Base URL of the trademark API deployment (default http://localhost:3000).
TRADEMARK_API_BASE=
TRADEMARK_API_KEY=
