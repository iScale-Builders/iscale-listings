# Supabase
NEXT_PUBLIC_SUPABASE_URL=<supabase-project-url>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
TM_DB_URL=<postgres-import-connection-url>
# Native PostgreSQL API only: uncomment when using that tested route.
# DATABASE_URL=<postgres-api-connection-url>
# Protect all API routes; register your own key with scripts/create-local-api-key.mjs.
REQUIRE_API_KEY=true

# Vercel
VERCEL_CRON_SECRET=<cron-secret>

# EUIPO Trademark Search API
EUIPO_CLIENT_ID=<euipo-client-id>
EUIPO_CLIENT_SECRET=<euipo-client-secret>
EUIPO_ACCESS_VERIFIED_AT=<iso-timestamp-after-successful-probe>
EUIPO_AUTH_URL=https://euipo.europa.eu/cas-server-webapp/oidc/accessToken
EUIPO_API_BASE=https://api.euipo.europa.eu/trademark-search
EUIPO_DELIVERY_PATH=<euipo-official-delivery-path>

# App
# Browser origins allowed to call the API cross-site (comma-separated). No
# origins are baked into the code — a production deployment MUST list its own
# frontends here or browser calls will fail CORS preflight.
ALLOWED_ORIGINS=https://your-app.vercel.app,chrome-extension://xxxxx
# Must be true to search EU (EUIPO) marks alongside the US.
ENABLE_MULTI_JURISDICTION_DB=true
TRUST_PROXY_HEADERS=false
# Set to 'test' to mint/verify sp_test_ API keys instead of sp_live_ (default live).
API_KEY_MODE=live

# Distributed API rate limiting
# Recommended in production; local development falls back to process memory.
RATE_LIMIT_REST_URL=https://your-redis-rest-endpoint
RATE_LIMIT_REST_TOKEN=<rate-limit-rest-token>
# Set to 'true' to REJECT requests when the shared rate-limit store is
# unreachable, instead of failing open to per-instance in-memory counting.
RATE_LIMIT_FAIL_CLOSED=false

