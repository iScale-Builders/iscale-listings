# Normalize line endings: LF in the repository, checked out per-platform. Keeps
# the repo deterministic regardless of a contributor's core.autocrlf setting.
* text=auto eol=lf

# Windows-only scripts want CRLF.
*.ps1 text eol=crlf

# Binary assets — never line-ending-converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
