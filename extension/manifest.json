{
  "manifest_version": 3,
  "name": "iScaleListings",
  "version": "0.6.44",
  "description": "Generate POD keywords and listings with US and EU trademark screening for product pages and marketplace fields.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "contextMenus", "sidePanel", "alarms"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "iScaleListings â€” click to open the side panel",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/duo.js"],
      "run_at": "document_idle"
    }
  ]
}
