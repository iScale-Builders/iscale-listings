{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "chrome"],
    "baseUrl": ".",
    "paths": { "@/*": ["../listing-core-runtime/src/*"] }
  },
  "include": ["**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
